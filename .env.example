# Client (incorporate nel bundle durante la build: NON metterci segreti)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=000000000000000
VITE_TURNSTILE_SITEKEY=0x0000000000000000000000
VITE_BOOKING_URL=https://calendar.app.google/xxxxxxxx
# Indirizzo mostrato come canale di riserva se l'invio del form fallisce.
# Se non impostato, il link non compare.
VITE_CONTACT_FALLBACK_EMAIL=mail@example.com

# Server (solo funzioni serverless in api/)
GEMINI_API_KEY=
# Invio email transazionali via SMTP di Resend (smtp.resend.com:465,
# utente 'resend', password = questa chiave).
RESEND_API_KEY=
# Mittente: deve appartenere a un dominio verificato su Resend.
MAIL_FROM=mail@example.com
# Destinatario delle notifiche di contatto. Se assente si usa MAIL_FROM.
CONTACT_TO=
# Verifica server-side del token Turnstile. Finche' e' assente il
# controllo e' inerte, cosi' l'attivazione non rompe il form.
TURNSTILE_SECRET=
